<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0900-revenue-reports-table" author="foxtrip">
        <createTable tableName="revenue_reports">
            <column name="id" type="${uuidType}" defaultValueComputed="public.uuid_generate_v7()"><constraints primaryKey="true" nullable="false"/></column>
            <column name="month" type="int"><constraints nullable="false"/></column>
            <column name="year" type="int"><constraints nullable="false"/></column>
            <column name="revenue_tour" type="decimal(15,2)" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="revenue_addon" type="decimal(15,2)" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="revenue_ads" type="decimal(15,2)" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="total_revenue" type="decimal(15,2)" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="total_orders" type="int" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="created_at" type="timestamp" defaultValueComputed="${now}"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp" defaultValueComputed="${now}"><constraints nullable="false"/></column>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
        </createTable>

        <addUniqueConstraint tableName="revenue_reports" columnNames="year, month" constraintName="uk_revenue_period"/>
    </changeSet>
</databaseChangeLog>
